{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://embeddedos.org/schemas/hardware-validation/v1/validation-cases.schema.json",
  "title": "eCAD Executable Validation Cases v1",
  "description": "Reviewed V3 golden or V4 corner cases executed by open-source reference adapters.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract_version", "gate", "cases"],
  "properties": {
    "$schema": {"const": "https://embeddedos.org/schemas/hardware-validation/v1/validation-cases.schema.json"},
    "contract_version": {"$ref": "common.schema.json#/definitions/contractVersion"},
    "gate": {"enum": ["V3", "V4"]},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/case"}
    }
  },
  "definitions": {
    "metricName": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "expectedMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "absolute_tolerance"],
      "properties": {
        "value": {"type": "number"},
        "absolute_tolerance": {"type": "number", "minimum": 0}
      }
    },
    "metricLimit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      },
      "anyOf": [
        {"required": ["minimum"]},
        {"required": ["maximum"]}
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "domain", "inputs", "requirement_ids"],
      "properties": {
        "id": {"$ref": "common.schema.json#/definitions/identifier"},
        "adapter": {"enum": ["python_control", "mujoco", "kicad", "ngspice", "iverilog"]},
        "domain": {"$ref": "common.schema.json#/definitions/domain"},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/definitions/relativePath"}
        },
        "arguments": {"type": "array", "items": {"type": "string"}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "seed": {"type": "integer"},
        "settings": {"type": "object"},
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/definitions/identifier"}
        },
        "expected_metrics": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/definitions/expectedMetric"}
        },
        "metric_limits": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/definitions/metricLimit"}
        }
      },
      "oneOf": [
        {"required": ["expected_metrics"], "not": {"required": ["metric_limits"]}},
        {"required": ["metric_limits"], "not": {"required": ["expected_metrics"]}}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"gate": {"const": "V3"}}},
      "then": {"properties": {"cases": {"items": {"required": ["expected_metrics"]}}}}
    },
    {
      "if": {"properties": {"gate": {"const": "V4"}}},
      "then": {"properties": {"cases": {"items": {"required": ["metric_limits"]}}}}
    }
  ]
}
