{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://embeddedos.org/schemas/hardware-validation/v1/product-manifest.schema.json",
  "title": "eCAD Product Input Manifest v1",
  "description": "Complete, hashed inventory of the inputs used for one product validation run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract_version", "product", "source", "generated_at", "artifacts"],
  "properties": {
    "$schema": {"const": "https://embeddedos.org/schemas/hardware-validation/v1/product-manifest.schema.json"},
    "contract_version": {"$ref": "common.schema.json#/definitions/contractVersion"},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": {"$ref": "common.schema.json#/definitions/identifier"},
        "path": {"$ref": "common.schema.json#/definitions/relativePath"}
      }
    },
    "source": {"$ref": "common.schema.json#/definitions/sourceRevision"},
    "generated_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "path",
          "sha256",
          "media_type",
          "size_bytes",
          "role",
          "provenance"
        ],
        "properties": {
          "artifact_id": {"$ref": "common.schema.json#/definitions/identifier"},
          "path": {"$ref": "common.schema.json#/definitions/relativePath"},
          "sha256": {"$ref": "common.schema.json#/definitions/sha256"},
          "media_type": {"$ref": "common.schema.json#/definitions/nonEmptyString"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "role": {"enum": ["design", "model", "simulation", "requirement", "configuration", "other"]},
          "provenance": {"$ref": "common.schema.json#/definitions/provenance"}
        }
      }
    }
  }
}
